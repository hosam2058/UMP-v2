{
  "name": "@ump/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/app.test.ts src/config.test.ts src/providers/sec-edgar.test.ts src/ingestion/sec-ingestion.test.ts src/identity/sec-supported-mappings.test.ts src/identity/curated-stock-mapping-registry.test.ts src/identity/curated-stock-mapping-onboarding.test.ts src/identity/curated-mapping-runtime-authorization.test.ts src/query-services/stored-sec-query-service.test.ts src/query-services/trusted-financial-query-runtime.test.ts",
    "test:postgres": "tsx --test src/ingestion/sec-ingestion.postgres.test.ts src/identity/curated-stock-mapping-onboarding.postgres.test.ts src/identity/curated-mapping-runtime-authorization.postgres.test.ts src/query-services/stored-sec-query-service.postgres.test.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs"
  },
  "dependencies": {
    "@ump/db": "workspace:*",
    "@ump/api-zod": "workspace:*",
    "cors": "2.8.6",
    "express": "5.2.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.9.4",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "2.3.3",
    "pino-pretty": "13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "4.23.0"
  }
}
